# Berean environment. Copy to .env.local (gitignored) and fill in.
# Everything is optional for local dev; production deploy wants all of these.

# Neon Postgres (sync rows + accounts). Leave unset for the sqlite dev dialect.
DATABASE_URL=

# Accounts (better-auth). Required in production; a dev fallback exists for sqlite.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Email delivery for magic links (Resend). Unset: links log server-side (dev mode).
RESEND_API_KEY=
RESEND_FROM=

# Scribe features (semantic search, briefs, critique, liturgy drafts).
# Unset: those routes answer an honest 503 and the rest of the app is unaffected.
MINIMAX_API_KEY=

# Sync driver override: memory (dev), or pg (selected by DATABASE_URL).
SYNC_DRIVER=
# Tombstone retention days for the purge route, default 30.
SYNC_TOMBSTONE_DAYS=
# Bearer secret for purge-all-namespaces (host cron; see DEPLOY.md).
SYNC_PURGE_SECRET=
# Client-side sync switch, baked at build time: 1 enables the Settings sync surface.
NEXT_PUBLIC_BEREAN_SYNC=
