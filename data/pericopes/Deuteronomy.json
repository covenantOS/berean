le Sacrifices"},{"verse":2,"heading":"Purge the Idolater"},{"verse":8,"heading":"Courts of Law"},{"verse":14,"heading":"Guidelines for a King","parallels":"1 Samuel 8:1–9"}]},{"chapter":18,"sections":[{"verse":1,"heading":"Provision for Priests and Levites","parallels":"1 Corinthians 9:1–18"},{"verse":9,"heading":"Sorcery Forbidden","parallels":"Acts 8:9–25"},{"verse":15,"heading":"A Prophet Like Moses","parallels":"Acts 3:11–26"}]},{"chapter":19,"sections":[{"verse":1,"heading":"Cities of Refuge","parallels":"Numbers 35:9–34; Deuteronomy 4:41–43; Joshua 20:1–9"},{"verse":15,"heading":"The Testimony of Two or Three Witnesses","parallels":"Matthew 18:15–20"}]},{"chapter":20,"sections":[{"verse":1,"heading":"Laws of Warfare"}]},{"chapter":21,"sections":[{"verse":1,"heading":"Atonement for an Unsolved Murder"},{"verse":10,"heading":"Marrying a Captive Woman"},{"verse":15,"heading":"Inheritance Rights of the Firstborn"},{"verse":18,"heading":"A Rebellious Son","parallels":"Luke 15:11–32"},{"verse":22,"heading":"Cursed Is Anyone Hung on a Tree"}]},{"chapter":22,"sections":[{"verse":1,"heading":"Various Laws"},{"verse":13,"heading":"Marriage Violations"}]},{"chapter":23,"sections":[{"verse":1,"heading":"Exclusion from the Congregation"},{"verse":9,"heading":"Uncleanness in the Camp","parallels":"Leviticus 15:1–12"},{"verse":15,"heading":"Miscellaneous Laws"}]},{"chapter":24,"sections":[{"verse":1,"heading":"Marriage and Divorce Laws","parallels":"Matthew 5:31–32; Luke 16:18"},{"verse":6,"heading":"Additional Laws"}]},{"chapter":25,"sections":[{"verse":1,"heading":"Fairness and Mercy"},{"verse":5,"heading":"Widowhood and Marriage"},{"verse":13,"heading":"Standard Weights and Measures","parallels":"Proverbs 11:1–3; Ezekiel 45:10–12"},{"verse":17,"heading":"Revenge on the Amalekites"}]},{"chapter":26,"sections":[{"verse":1,"heading":"Offering Firstfruits and Tithes","parallels":"Leviticus 27:30–34; Deuteronomy 14:22–29; Nehemiah 13:10–14"},{"verse":16,"heading":"Obey the LOR