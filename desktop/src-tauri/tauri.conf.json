{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Berean",
  "version": "0.1.0",
  "identifier": "com.churchposting.berean",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "Berean",
        "url": "http://localhost:3000",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Reference",
    "shortDescription": "Scripture study and authored knowledge",
    "longDescription": "Berean — a study prepared. Scripture reader, marginalia, sermon preparation, liturgy composition, and the ordered life, by Church Posting."
  }
}
